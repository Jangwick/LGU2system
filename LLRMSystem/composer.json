{
    "name": "lgu/llrm-system",
    "description": "Legislative Records Management System",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "modules/core/utils",
            "modules/core/middleware"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml",
        "test:unit": "phpunit --configuration tests/phpunit.xml --testsuite Unit",
        "test:integration": "phpunit --configuration tests/phpunit.xml --testsuite Integration",
        "test:functional": "phpunit --configuration tests/phpunit.xml --testsuite Functional",
        "test:database": "phpunit --configuration tests/phpunit.xml --testsuite Database",
        "test:a11y": "phpunit --configuration tests/phpunit.xml --testsuite Accessibility",
        "test:coverage": "phpunit --configuration tests/phpunit.xml --coverage-html tests/coverage-html"
    }
}
